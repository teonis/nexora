# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Session / JWT ──────────────────────────────────────────────────────────
# A long random secret used to sign session JWTs (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Full callback URL registered in Google Cloud Console
# For local development use: http://localhost:3000/api/auth/callback/google
GOOGLE_CALLBACK_URL=https://nexora-production-e466.up.railway.app/api/auth/callback/google

# ─── Application ────────────────────────────────────────────────────────────
# Google "sub" of the user who should have superadmin access
OWNER_OPEN_ID=google_sub_of_superadmin

# ─── AI / External APIs ─────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# Optional: Forge API (built-in AI features)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: AWS S3 (file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Optional: Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
